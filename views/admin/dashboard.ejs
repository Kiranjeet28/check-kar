<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Dashboard | InfoCascade</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link href="https://cdn.jsdelivr.net/npm/quill@2.0.0/dist/quill.snow.css" rel="stylesheet" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
    rel="stylesheet">
  <style>
    :root {
      --primary-color: #4e73df;
      --primary-dark: #3a5bc7;
      --secondary-color: #2c3e50;
      --accent-color: #e74c3c;
      --warning-color: #f6c23e;
      --ink: #1f2a37;
      --muted: #6b7a90;
      --line: #e6eaf1;
      --radius: 18px;
      --shadow-sm: 0 6px 20px -10px rgba(24, 39, 75, 0.28);
      --shadow-lg: 0 24px 60px -28px rgba(24, 39, 75, 0.4);
    }

    body {
      background:
        radial-gradient(900px 460px at 100% -8%, rgba(78, 115, 223, 0.14), transparent 60%),
        #f5f7fb;
      font-family: 'Plus Jakarta Sans', 'Segoe UI', Tahoma, sans-serif;
      color: var(--ink);
      -webkit-font-smoothing: antialiased;
    }

    h2,
    h4,
    h5 {
      letter-spacing: -0.02em;
      font-weight: 700;
    }

    .admin-header {
      background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
      color: #fff;
      padding: 1.75rem 2rem;
      border-radius: var(--radius);
      margin-bottom: 1.5rem;
      box-shadow: var(--shadow-lg);
    }

    .admin-header h2 {
      margin-bottom: 0.15rem;
      font-weight: 800;
    }

    .admin-header p {
      opacity: 0.8;
      font-size: 0.9rem;
    }

    .header-badge {
      width: 52px;
      height: 52px;
      border-radius: 15px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(255, 255, 255, 0.16);
      font-size: 1.25rem;
    }

    .btn-light {
      border-radius: 999px;
      font-weight: 600;
      padding: 0.55rem 1.25rem;
      background: rgba(255, 255, 255, 0.16);
      border: 1px solid rgba(255, 255, 255, 0.35);
      color: #fff;
    }

    .btn-light:hover {
      background: rgba(255, 255, 255, 0.28);
      color: #fff;
    }

    .stat-card {
      background: #fff;
      border-radius: 16px;
      padding: 1.15rem 1.25rem;
      box-shadow: var(--shadow-sm);
      border: 1px solid var(--line);
      display: flex;
      align-items: center;
      gap: 0.9rem;
      height: 100%;
    }

    .stat-icon {
      width: 44px;
      height: 44px;
      border-radius: 13px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(78, 115, 223, 0.12);
      color: var(--primary-color);
    }

    .stat-value {
      font-size: 1.5rem;
      font-weight: 800;
      line-height: 1;
      color: var(--secondary-color);
    }

    .stat-label {
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--muted);
    }

    .notice-form,
    .panel {
      background-color: #fff;
      border-radius: var(--radius);
      padding: 2rem;
      box-shadow: var(--shadow-sm);
      border: 1px solid var(--line);
      margin-bottom: 1.5rem;
    }

    .section-title {
      display: flex;
      align-items: center;
      gap: 0.55rem;
      color: var(--secondary-color);
    }

    .section-title i {
      color: var(--primary-color);
    }

    .form-label {
      font-weight: 600;
      font-size: 0.85rem;
      color: var(--secondary-color);
    }

    .form-control {
      padding: 0.75rem 1rem;
      border-radius: 12px;
      border: 1px solid var(--line);
      background: #fbfcfe;
    }

    .form-control:focus {
      background: #fff;
      border-color: var(--primary-color);
      box-shadow: 0 0 0 4px rgba(78, 115, 223, 0.15);
    }

    .notice-card {
      background-color: #fff;
      border-radius: 16px;
      box-shadow: var(--shadow-sm);
      margin-bottom: 1rem;
      border: 1px solid var(--line);
      border-left: 4px solid var(--primary-color);
      transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .notice-card:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow-lg);
    }

    .notice-card h5 {
      color: var(--secondary-color);
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
      border: none;
      padding: 0.7rem 1.6rem;
      border-radius: 12px;
      font-weight: 700;
      box-shadow: 0 12px 24px -14px rgba(78, 115, 223, 0.85);
    }

    .btn-primary:hover {
      transform: translateY(-1px);
    }

    .btn-danger {
      background-color: var(--accent-color);
      border-color: var(--accent-color);
    }

    .btn-warning {
      background-color: var(--warning-color);
      border-color: var(--warning-color);
      color: #212529;
    }

    .btn-sm {
      border-radius: 10px;
      font-weight: 600;
    }

    .btn-secondary,
    .btn-info {
      border-radius: 999px;
      font-weight: 600;
      padding: 0.55rem 1.25rem;
    }

    .btn-secondary {
      background-color: var(--secondary-color);
      border-color: var(--secondary-color);
    }

    .btn-info {
      background-color: #fff;
      border: 1px solid var(--line);
      color: var(--secondary-color);
    }

    .btn-info:hover {
      background-color: #f2f5fb;
      color: var(--primary-color);
    }

    .divider {
      border-top: 2px dashed var(--line);
      margin: 2.25rem 0;
    }

    .action-buttons {
      min-width: 190px;
      text-align: right;
      display: flex;
      gap: 0.5rem;
      justify-content: flex-end;
    }

    .notice-date {
      font-size: 0.8rem;
      color: var(--muted);
    }

    .notice-date i {
      color: var(--primary-color);
    }

    textarea.form-control {
      min-height: 150px;
    }

    #editorContainer {
      background: #fff;
      border: 1px solid var(--line) !important;
      border-radius: 0 0 12px 12px !important;
    }

    .ql-toolbar.ql-snow {
      border: 1px solid var(--line) !important;
      border-radius: 12px 12px 0 0;
      background: #fbfcfe;
    }

    .table {
      --bs-table-bg: #fff;
      margin-bottom: 0;
    }

    .table> :not(caption)>*>* {
      padding: 0.8rem 0.9rem;
    }

    .table thead th {
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--muted);
      background: #f4f6fb;
      border-bottom: 1px solid var(--line);
    }

    .table-bordered {
      border-radius: 14px;
      overflow: hidden;
    }

    .alert-info {
      background: rgba(78, 115, 223, 0.08);
      border: 1px solid rgba(78, 115, 223, 0.18);
      color: var(--secondary-color);
      border-radius: 14px;
      font-weight: 500;
    }

    footer {
      background: var(--secondary-color) !important;
      border-radius: 18px 18px 0 0;
    }

    footer p {
      font-size: 0.85rem;
      opacity: 0.85;
    }
  </style>
</head>

<body>

  <div class="container py-5">
    <!-- Admin Header -->
    <div class="admin-header d-flex flex-wrap gap-3 justify-content-between align-items-center">
      <div class="d-flex align-items-center gap-3">
        <div class="header-badge"><i class="fas fa-user-shield"></i></div>
        <div>
          <h2 class="mb-0">Welcome <%= admin.name %>
          </h2>
          <p class="mb-0">Admin Dashboard · InfoCascade</p>
        </div>
      </div>
      <a href="/admin/logout" class="btn btn-light">
        <i class="fas fa-sign-out-alt me-1"></i>Logout
      </a>
    </div>

    <!-- Quick stats -->
    <div class="row g-3 mb-4">
      <div class="col-md-4">
        <div class="stat-card">
          <div class="stat-icon"><i class="fas fa-bullhorn"></i></div>
          <div>
            <div class="stat-value">
              <%= notices ? notices.length : 0 %>
            </div>
            <div class="stat-label">Notices posted</div>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="stat-card">
          <div class="stat-icon"><i class="fas fa-users"></i></div>
          <div>
            <div class="stat-value">
              <%= users ? users.length : 0 %>
            </div>
            <div class="stat-label">Subscribed users</div>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="stat-card">
          <div class="stat-icon"><i class="fas fa-comment-dots"></i></div>
          <div>
            <div class="stat-value">
              <%= feedbacks ? feedbacks.length : 0 %>
            </div>
            <div class="stat-label">Feedback received</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Post New Notice Card -->
    <div class="notice-form">
      <h4 class="section-title mb-4"><i class="fas fa-plus-circle"></i>Post New Notice</h4>
      <form action="/admin/post-notice" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="mb-3">
          <label class="form-label">Notice Title</label>
          <input type="text" name="title" class="form-control" placeholder="Enter notice title" required />
        </div>
        <div class="mb-4">
          <label class="form-label">Notice Content</label>
          <div id="editorContainer" style="height: 300px;"></div>
          <input type="hidden" name="content" id="contentInput">
        </div>
        <button type="submit" class="btn btn-primary">
          <i class="fas fa-paper-plane me-1"></i>Post Notice
        </button>
      </form>
    </div>

    <div class="divider"></div>

    <!-- Recent Notices Section -->
    <div class="recent-notices">
      <h4 class="section-title mb-4"><i class="fas fa-history"></i>Recently Posted Notices</h4>

      <% if (notices && notices.length===0) { %>
        <div class="alert alert-info">
          <i class="fas fa-info-circle me-2"></i>No notices have been posted yet.
        </div>
        <% } else { %>
          <div class="notice-list">
            <% notices.forEach(notice=> { %>
              <div class="notice-card p-4 mb-3">
                <div class="d-flex flex-wrap gap-3 justify-content-between">
                  <div class="flex-grow-1" style="min-width: 260px;">
                    <h5 class="fw-bold mb-2">
                      <%= notice.title %>
                    </h5>
                    <div class="mb-3"><%- notice.message %></div>
                    <div class="notice-date">
                      <i class="fas fa-user me-1"></i>
                      Posted by <%= notice.postedBy && notice.postedBy.name ? notice.postedBy.name : 'Admin' %>
                        <i class="fas fa-calendar-alt ms-3 me-1"></i>
                        <%= notice.date ? new Date(notice.date).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata' })
                          : '' %>
                    </div>
                  </div>
                  <div class="action-buttons">
                    <a href="/admin/edit-notice/<%= notice._id %>" class="btn btn-warning btn-sm">
                      <i class="fas fa-edit me-1"></i>Edit
                    </a>
                    <form action="/admin/delete-notice/<%= notice._id %>" method="POST"
                      onsubmit="return confirm('Are you sure you want to delete this notice?');" class="d-inline">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="btn btn-danger btn-sm">
                        <i class="fas fa-trash-alt me-1"></i>Delete
                      </button>
                    </form>
                  </div>
                </div>
              </div>
              <% }) %>
          </div>
          <% } %>
    </div>

    <!-- View All Users & Feedback Table Buttons -->
    <div class="mt-4 mb-4 d-flex flex-wrap gap-2">
      <button class="btn btn-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#usersTable"
        aria-expanded="false" aria-controls="usersTable">
        <i class="fas fa-users me-1"></i> View All Users
      </button>
      <button class="btn btn-info" type="button" data-bs-toggle="collapse" data-bs-target="#feedbackTableCollapse"
        aria-expanded="false" aria-controls="feedbackTableCollapse">
        <i class="fas fa-table me-1"></i> View Feedback Table
      </button>
    </div>

    <!-- Feedback Table (Collapsed by default) -->
    <div class="collapse" id="feedbackTableCollapse">
      <div class="panel">
        <h5 class="section-title mb-3"><i class="fas fa-comment-dots"></i>Feedback</h5>
        <% if (feedbacks && feedbacks.length===0) { %>
          <div class="alert alert-info mb-0">
            <i class="fas fa-info-circle me-2"></i>No feedback has been submitted yet.
          </div>
          <% } else { %>
            <div class="table-responsive">
              <table class="table table-bordered align-middle">
                <thead>
                  <tr>
                    <th>#</th>
                    <th>Title</th>
                    <th>Details</th>
                    <th>Contact</th>
                    <th>Date</th>
                  </tr>
                </thead>
                <tbody>
                  <% feedbacks.forEach((feedback, idx)=> { %>
                    <tr>
                      <td>
                        <%= idx + 1 %>
                      </td>
                      <td class="fw-semibold">
                        <%= feedback.title %>
                      </td>
                      <td>
                        <%= feedback.details %>
                      </td>
                      <td>
                        <%= feedback.contact || '-' %>
                      </td>
                      <td>
                        <%= feedback.createdAt ? new Date(feedback.createdAt).toLocaleString('en-IN', {
                          timeZone: 'Asia/Kolkata' }) : '' %>
                      </td>
                    </tr>
                    <% }) %>
                </tbody>
              </table>
            </div>
            <% } %>
      </div>
    </div>

    <!-- Users Table (Collapsed by default) -->
    <div class="collapse" id="usersTable">
      <div class="panel">
        <h5 class="section-title mb-3"><i class="fas fa-users"></i>Registered Users</h5>

        <!-- Filter Users -->
        <div class="mb-3">
          <input type="text" id="userFilterInput" class="form-control" placeholder="Search by name or email...">
        </div>

        <div class="table-responsive">
          <table class="table table-bordered align-middle">
            <thead>
              <tr>
                <th>S.No.</th>
                <th>Name</th>
                <th>Email</th>
                <th>Department</th>
                <th>Group</th>
                <th>Branch</th>
                <th>Year</th>
                <th>URN</th>
                <th>CRN</th>
                <th>Subscribed At</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% users.forEach((user, idx)=> { %>
                <tr>
                  <td>
                    <%= idx + 1 %>
                  </td>
                  <td class="fw-semibold">
                    <%= user.name %>
                  </td>
                  <td>
                    <%= user.email %>
                  </td>
                  <td>
                    <%= user.department || '-' %>
                  </td>
                  <td>
                    <%= user.group || '-' %>
                  </td>
                  <td>
                    <%= user.branch %>
                  </td>
                  <td>
                    <%= user.year %>
                  </td>
                  <td>
                    <%= user.urn %>
                  </td>
                  <td>
                    <%= user.crn %>
                  </td>
                  <td>
                    <%= user.subscribedAt ? new Date(user.subscribedAt).toLocaleString('en-IN', {
                      timeZone: 'Asia/Kolkata' }) : '' %>
                  </td>
                  <td>
                    <form action="/admin/remove-user/<%= user._id %>" method="POST"
                      onsubmit="return confirm('Are you sure you want to remove this user?');">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="btn btn-danger btn-sm">
                        <i class="fas fa-user-times me-1"></i>Remove
                      </button>
                    </form>
                  </td>
                </tr>
                <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/quill@2.0.0/dist/quill.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      // Filter users table by name or email
      const filterInput = document.getElementById('userFilterInput');
      if (filterInput) {
        filterInput.addEventListener('input', function () {
          const filter = this.value.toLowerCase();
          const rows = document.querySelectorAll('#usersTable tbody tr');
          rows.forEach(row => {
            const name = (row.children[1]?.textContent || '').toLowerCase();
            const email = (row.children[2]?.textContent || '').toLowerCase();
            if (name.includes(filter) || email.includes(filter)) {
              row.style.display = '';
            } else {
              row.style.display = 'none';
            }
          });
        });
      }

      // Initialize Quill editor
      const quill = new Quill('#editorContainer', {
        theme: 'snow',
        modules: {
          toolbar: [
            ['bold', 'italic', 'underline', 'strike'],
            ['blockquote', 'code-block'],
            [{ 'header': 1 }, { 'header': 2 }],
            [{ 'list': 'ordered' }, { 'list': 'bullet' }],
            ['link', 'image'],
            ['clean']
          ]
        },
        placeholder: 'Enter notice content with formatting...'
      });

      // Before form submit, populate hidden input with editor content
      const form = document.querySelector('form');
      if (form) {
        form.addEventListener('submit', function (e) {
          const content = quill.root.innerHTML;
          document.getElementById('contentInput').value = content;
        });
      }
    });
  </script>

  <!-- Footer -->
  <footer class="bg-dark text-white text-center py-3 mt-5">
    <div class="container">
      <p class="mb-0">© 2025 InfoCascade - Jai Hoo Satnaryan.</p>
      <p class="mb-0">Designed and Developed by Karan Singh.</p>
    </div>
  </footer>
</body>

</html>