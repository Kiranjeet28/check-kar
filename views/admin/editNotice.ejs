<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Edit Notice | InfoCascade</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link href="https://cdn.jsdelivr.net/npm/quill@2.0.0/dist/quill.snow.css" rel="stylesheet" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
    rel="stylesheet">
  <style>
    :root {
      --primary-color: #4e73df;
      --primary-dark: #3a5bc7;
      --secondary-color: #2c3e50;
      --accent-color: #e74c3c;
      --ink: #1f2a37;
      --muted: #6b7a90;
      --line: #e6eaf1;
      --shadow-lg: 0 24px 60px -26px rgba(24, 39, 75, 0.38);
    }

    body {
      background:
        radial-gradient(900px 460px at 8% -10%, rgba(78, 115, 223, 0.16), transparent 60%),
        #f5f7fb;
      font-family: 'Plus Jakarta Sans', 'Segoe UI', Tahoma, sans-serif;
      color: var(--ink);
      min-height: 100vh;
      display: flex;
      align-items: center;
      -webkit-font-smoothing: antialiased;
      padding: 3rem 0;
    }

    .edit-container {
      max-width: 820px;
      width: 100%;
      margin: 0 auto;
    }

    .edit-card {
      background-color: #fff;
      border-radius: 20px;
      box-shadow: var(--shadow-lg);
      padding: 2.5rem;
      border: 1px solid var(--line);
      border-top: 4px solid var(--primary-color);
    }

    .form-header {
      margin-bottom: 2rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--line);
    }

    .form-header h2 {
      color: var(--secondary-color);
      font-weight: 800;
      letter-spacing: -0.02em;
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }

    .form-header h2 i {
      color: var(--primary-color);
    }

    .form-header p {
      font-size: 0.9rem;
      color: var(--muted);
    }

    .form-label {
      font-weight: 600;
      font-size: 0.85rem;
      color: var(--secondary-color);
      margin-bottom: 0.5rem;
    }

    .form-control {
      padding: 0.8rem 1rem;
      border-radius: 12px;
      border: 1px solid var(--line);
      background: #fbfcfe;
      transition: all 0.2s ease;
    }

    .form-control:focus {
      background: #fff;
      border-color: var(--primary-color);
      box-shadow: 0 0 0 4px rgba(78, 115, 223, 0.15);
    }

    #editorContainer {
      background: #fff;
      border: 1px solid var(--line) !important;
      border-radius: 0 0 12px 12px !important;
    }

    .ql-toolbar.ql-snow {
      border: 1px solid var(--line) !important;
      border-radius: 12px 12px 0 0;
      background: #fbfcfe;
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
      border: none;
      padding: 0.8rem 1.5rem;
      border-radius: 12px;
      font-weight: 700;
      box-shadow: 0 12px 24px -14px rgba(78, 115, 223, 0.85);
    }

    .btn-secondary {
      background-color: #fff;
      border: 1px solid var(--line);
      color: var(--secondary-color);
      padding: 0.8rem 1.5rem;
      border-radius: 12px;
      font-weight: 600;
    }

    .btn-secondary:hover {
      background-color: #f2f5fb;
      color: var(--accent-color);
    }

    .btn-group {
      gap: 1rem;
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: 1.25rem;
      color: var(--primary-color);
      font-weight: 600;
      font-size: 0.9rem;
      text-decoration: none;
    }

    .back-link:hover {
      text-decoration: underline;
    }
  </style>
</head>

<body>
  <div class="edit-container">
    <a href="/admin/dashboard" class="back-link">
      <i class="fas fa-arrow-left"></i>Back to Dashboard
    </a>

    <div class="edit-card">
      <div class="form-header">
        <h2><i class="fas fa-edit"></i>Edit Notice</h2>
        <p class="text-muted mb-0">Update the notice details below</p>
      </div>

      <form action="/admin/edit-notice/<%= notice._id %>" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="mb-4">
          <label class="form-label">Notice Title</label>
          <input type="text" name="title" class="form-control" value="<%= notice.title %>"
            placeholder="Enter notice title" required />
        </div>

        <div class="mb-4">
          <label class="form-label">Notice Content</label>
          <div id="editorContainer" style="height: 300px;"></div>
          <input type="hidden" name="content" id="contentInput">
        </div>

        <div class="d-flex flex-column flex-sm-row btn-group">
          <button type="submit" class="btn btn-primary flex-grow-1">
            <i class="fas fa-save me-2"></i>Update Notice
          </button>
          <a href="/admin/dashboard" class="btn btn-secondary flex-grow-1">
            <i class="fas fa-times me-2"></i>Cancel
          </a>
        </div>
      </form>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/quill@2.0.0/dist/quill.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      // Initialize Quill editor with existing notice content
      const quill = new Quill('#editorContainer', {
        theme: 'snow',
        modules: {
          toolbar: [
            ['bold', 'italic', 'underline', 'strike'],
            ['blockquote', 'code-block'],
            [{ 'header': 1 }, { 'header': 2 }],
            [{ 'list': 'ordered' }, { 'list': 'bullet' }],
            ['link', 'image'],
            ['clean']
          ]
        },
        placeholder: 'Enter notice content with formatting...'
      });

      // Load existing content (notice.message contains HTML from Quill)
      const existingContent = `<%- notice.message %>`;
      quill.root.innerHTML = existingContent;

      // Before form submit, populate hidden input with editor content
      const form = document.querySelector('form');
      if (form) {
        form.addEventListener('submit', function (e) {
          const content = quill.root.innerHTML;
          document.getElementById('contentInput').value = content;
        });
      }
    });
  </script>
</body>

</html>