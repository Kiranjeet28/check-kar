  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Feedback form AJAX submission
    document.addEventListener('DOMContentLoaded', function () {
      const feedbackForm = document.getElementById('feedbackForm');
      const feedbackAlert = document.getElementById('feedbackAlert');
      const feedbackModal = document.getElementById('feedbackModal');
      if (feedbackForm) {
        var contactInput = document.getElementById('feedbackContact');
        if (contactInput) {
          contactInput.addEventListener('input', function () {
            var v = contactInput.value.replace(/\D/g, '').slice(0, 10);
            if (contactInput.value !== v) contactInput.value = v;
          });
        }
        feedbackForm.addEventListener('submit', async function (e) {
          e.preventDefault();
          feedbackAlert.className = 'alert d-none rounded-4';
          const title = feedbackForm.title.value.trim();
          const details = feedbackForm.details.value.trim();
          const contact = feedbackForm.contact.value.trim();
          const csrfToken = document.getElementById('csrfToken').value;
          if (!title || !details) {
            feedbackAlert.className = 'alert alert-danger rounded-4';
            feedbackAlert.textContent = 'Please fill in the title and details.';
            return;
          }
          if (contact && !/^\d{10}$/.test(contact)) {
            feedbackAlert.className = 'alert alert-danger rounded-4';
            feedbackAlert.textContent = 'Contact number must be exactly 10 digits, numbers only.';
            return;
          }
          try {
            const res = await fetch('/feedback', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'CSRF-Token': csrfToken
              },
              body: JSON.stringify({ title, details, contact })
            });
            const json = await res.json();
            if (res.ok) {
              feedbackAlert.className = 'alert alert-success rounded-4';
              feedbackAlert.textContent = json.message || 'Feedback submitted!';
              feedbackForm.reset();
              setTimeout(() => {
                const modal = bootstrap.Modal.getInstance(feedbackModal);
                if (modal) modal.hide();
                feedbackAlert.className = 'alert d-none rounded-4';
              }, 1500);
            } else if (res.status === 429) {
              feedbackAlert.className = 'alert alert-warning rounded-4';
              feedbackAlert.textContent = json.error || 'You have already submitted feedback.';
            } else {
              feedbackAlert.className = 'alert alert-danger rounded-4';
              feedbackAlert.textContent = json.error || 'Failed to submit feedback.';
            }
          } catch (err) {
            feedbackAlert.className = 'alert alert-danger rounded-4';
            feedbackAlert.textContent = 'Network error. Try again later.';
          }
        });
      }
    });
  </script>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const yearEl = document.getElementById('currentYear');
      if (yearEl) yearEl.textContent = new Date().getFullYear();

      const backToTopButton = document.getElementById('backToTop');
      if (!backToTopButton) return;

      window.addEventListener('scroll', function () {
        backToTopButton.style.display = window.scrollY > 150 ? 'block' : 'none';
      });

      backToTopButton.addEventListener('click', function () {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    });
  </script>
</body>

</html>