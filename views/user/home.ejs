<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>InfoCascade | College Notices, Results & Timetables</title>
  <meta name="description"
    content="InfoCascade delivers trusted and timely college notices, results, fee updates, events and live class timetables in one place." />
  <link rel="icon" href="/images/Infocascade.png" type="image/png" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
    rel="stylesheet">
  <style>
    :root {
      --primary-color: #4e73df;
      --primary-dark: #3a5bc7;
      --secondary-color: #2c3e50;
      --accent-color: #e74c3c;
      --ink: #1f2a37;
      --muted: #6b7a90;
      --line: #e6eaf1;
      --radius: 18px;
      --shadow: 0 22px 55px -28px rgba(24, 39, 75, 0.32);
    }

    body {
      background:
        radial-gradient(900px 480px at 8% -10%, rgba(78, 115, 223, 0.16), transparent 60%),
        radial-gradient(760px 460px at 100% 6%, rgba(44, 62, 80, 0.12), transparent 60%),
        #f5f7fb;
      font-family: 'Plus Jakarta Sans', 'Segoe UI', Tahoma, sans-serif;
      color: var(--ink);
      -webkit-font-smoothing: antialiased;
    }

    .navbar {
      background: rgba(255, 255, 255, 0.85) !important;
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--line);
    }

    .navbar-brand {
      font-weight: 800;
      letter-spacing: -0.02em;
      color: var(--secondary-color) !important;
    }

    .navbar .nav-link {
      color: var(--muted) !important;
      font-weight: 600;
      font-size: 0.92rem;
    }

    .navbar .nav-link.active,
    .navbar .nav-link:hover {
      color: var(--primary-color) !important;
    }

    .hero-header {
      background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
      color: #fff;
      border-radius: 26px;
      padding: 3.2rem 2rem;
      margin-bottom: 2rem;
      box-shadow: var(--shadow);
      position: relative;
      overflow: hidden;
    }

    .hero-header::after {
      content: '';
      position: absolute;
      inset: auto -60px -120px auto;
      width: 320px;
      height: 320px;
      background: rgba(255, 255, 255, 0.08);
      border-radius: 50%;
    }

    .hero-header h1 {
      font-weight: 800;
      letter-spacing: -0.03em;
    }

    .hero-header p {
      opacity: 0.88;
      max-width: 720px;
      margin: 0 auto;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      justify-content: center;
      margin-top: 1.6rem;
    }

    .btn-hero {
      border-radius: 999px;
      padding: 0.7rem 1.4rem;
      font-weight: 700;
      background: #fff;
      color: var(--secondary-color);
      border: none;
      text-decoration: none;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .btn-hero:hover {
      transform: translateY(-2px);
      box-shadow: 0 14px 28px -14px rgba(0, 0, 0, 0.5);
      color: var(--primary-dark);
    }

    .btn-hero-ghost {
      background: rgba(255, 255, 255, 0.14);
      color: #fff;
      border: 1px solid rgba(255, 255, 255, 0.35);
    }

    .btn-hero-ghost:hover {
      background: rgba(255, 255, 255, 0.24);
      color: #fff;
    }

    .section-title {
      font-weight: 800;
      letter-spacing: -0.02em;
    }

    .notice-card {
      border: 1px solid var(--line);
      border-left: 4px solid var(--primary-color);
      border-radius: 16px;
      background: #fff;
      transition: transform 0.25s ease, box-shadow 0.25s ease;
      margin-bottom: 1.25rem;
    }

    .notice-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 20px 40px -26px rgba(24, 39, 75, 0.55);
    }

    .notice-card .card-title {
      font-weight: 700;
      letter-spacing: -0.01em;
    }

    .notice-meta {
      font-size: 0.78rem;
      color: var(--muted);
    }

    .student-class-card {
      border: 1px solid var(--line);
      border-radius: 18px;
      background: linear-gradient(135deg, #eef4ff, #ffffff);
      box-shadow: var(--shadow);
      margin-bottom: 1.5rem;
    }

    .class-chip {
      display: inline-block;
      border-radius: 999px;
      padding: 0.2rem 0.7rem;
      font-size: 0.76rem;
      font-weight: 800;
      margin-right: 0.4rem;
      background: #e5edfb;
      color: var(--primary-dark);
    }

    .modal-content {
      border: none;
      border-radius: 20px;
      overflow: hidden;
    }

    .modal-header {
      background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
      color: #fff;
      border-bottom: none;
    }

    .form-control,
    .form-select {
      border-radius: 12px;
      border: 1px solid var(--line);
      background: #fbfcfe;
      padding: 0.7rem 1rem;
    }

    .form-control:focus,
    .form-select:focus {
      background: #fff;
      border-color: var(--primary-color);
      box-shadow: 0 0 0 4px rgba(78, 115, 223, 0.15);
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
      border: none;
      border-radius: 12px;
      font-weight: 700;
    }

    .text-accent {
      color: var(--accent-color);
    }

    /* Team & Admin */
    .team-section {
      background: #fff;
      border-top: 1px solid var(--line);
    }

    .profile-card {
      border: 1px solid var(--line);
      overflow: hidden;
      border-radius: 18px;
      background: #fff;
      transition: transform .28s ease, box-shadow .28s ease;
    }

    .profile-card:hover {
      transform: translateY(-8px);
      box-shadow: var(--shadow);
    }

    .profile-avatar {
      width: 132px;
      height: 132px;
      object-fit: cover;
      border-radius: 50%;
      border: 6px solid #fff;
      box-shadow: 0 10px 24px rgba(78, 115, 223, .18);
    }

    .team-badge {
      background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
      color: #fff;
      padding: .35rem .75rem;
      border-radius: 999px;
      font-size: .78rem;
      font-weight: 700;
    }

    .social-icon {
      width: 38px;
      height: 38px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      background: #f2f5fa;
      color: var(--secondary-color);
      margin: 0 .15rem;
      transition: all .2s;
    }

    .social-icon:hover {
      transform: translateY(-3px);
      background: var(--primary-color);
      color: #fff;
    }

    .timetable-fab {
      position: fixed;
      top: 110px;
      right: 26px;
      z-index: 1030;
      border-radius: 999px;
      padding: 0.7rem 1.25rem;
      font-weight: 700;
      background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
      color: #fff;
      text-decoration: none;
      box-shadow: 0 16px 32px -16px rgba(78, 115, 223, 0.9);
    }

    .timetable-fab:hover {
      color: #fff;
      transform: translateY(-2px);
    }

    #backToTop {
      position: fixed;
      bottom: 26px;
      right: 26px;
      display: none;
      background: var(--secondary-color);
      color: #fff;
      border: none;
      width: 46px;
      height: 46px;
      border-radius: 50%;
      font-size: 1rem;
      box-shadow: 0 12px 24px -12px rgba(0, 0, 0, 0.6);
      cursor: pointer;
      z-index: 1040;
    }

    footer {
      background: var(--secondary-color) !important;
    }

    footer a:hover {
      text-decoration: underline;
      color: #cfe9ff;
    }

    @media (max-width: 992px) {
      .timetable-fab {
        display: none;
      }
    }

    @media (max-width: 576px) {
      .hero-header {
        padding: 2.2rem 1.2rem;
        border-radius: 20px;
      }
    }
  </style>
</head>

<body>
  <nav class="navbar navbar-expand-lg sticky-top">
    <div class="container">
      <a class="navbar-brand" href="/"><i class="fas fa-tower-broadcast me-2 text-primary"></i>InfoCascade</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
        aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="mainNavbar">
        <div class="navbar-nav ms-auto text-center">
          <a class="nav-link active" href="/">Home</a>
          <a class="nav-link" href="/timetable">Timetable</a>
          <a class="nav-link" href="#" data-bs-toggle="modal" data-bs-target="#feedbackModal">Feedback</a>
          <% if (currentUser) { %>
            <a class="nav-link" href="/profile">Profile</a>
            <% } else { %>
              <a class="nav-link" href="/login">Login</a>
              <% } %>
        </div>
      </div>
    </div>
  </nav>

  <!-- Feedback Modal -->
  <div class="modal fade" id="feedbackModal" tabindex="-1" aria-labelledby="feedbackModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="feedbackModalLabel"><i class="fas fa-comment-dots me-2"></i>Submit Feedback</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <form id="feedbackForm" autocomplete="off">
          <input type="hidden" name="_csrf" id="csrfToken"
            value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
          <div class="modal-body">
            <div class="mb-3">
              <label for="feedbackTitle" class="form-label fw-semibold">Title</label>
              <input type="text" class="form-control" id="feedbackTitle" name="title" maxlength="100" required
                placeholder="Enter a short title">
            </div>
            <div class="mb-3">
              <label for="feedbackDetails" class="form-label fw-semibold">Details</label>
              <textarea class="form-control" id="feedbackDetails" name="details" rows="4" maxlength="500" required
                placeholder="Describe your feedback"></textarea>
            </div>
            <div class="mb-3">
              <label for="feedbackContact" class="form-label fw-semibold">Contact number (optional)</label>
              <input type="text" class="form-control" id="feedbackContact" name="contact" inputmode="numeric"
                maxlength="10" autocomplete="tel" placeholder="10-digit mobile number, numbers only"
                title="If provided, enter exactly 10 digits">
            </div>
            <div id="feedbackAlert" class="alert d-none rounded-4" role="alert"></div>
          </div>
          <div class="modal-footer border-0">
            <button type="button" class="btn btn-light rounded-3 fw-semibold" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary">Submit</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div class="container py-5">
    <!-- Hero -->
    <div class="hero-header text-center">
      <h1 class="display-5 fw-bold">Welcome to InfoCascade</h1>
      <p class="lead">
        A one-stop source for all important notifications — academic updates, results, fees, events and more.
        Join the flow of trusted and timely information.
      </p>
      <div class="hero-actions">
        <a href="/timetable" class="btn-hero"><i class="fas fa-calendar-alt me-2"></i>View Timetable</a>
        <a href="/admin/login" class="btn-hero btn-hero-ghost"><i class="fas fa-lock me-2"></i>Admin Login</a>
      </div>
    </div>

    <!-- Live class summary -->
    <% if (currentUser && studentClassSummary) { %>
      <div class="row mb-4">
        <div class="col-lg-8 mx-auto">
          <div class="card student-class-card">
            <div class="card-body p-4">
              <h5 class="mb-2 fw-bold">
                <i class="fas fa-user-clock text-primary me-2"></i>Your Live Class Update
              </h5>
              <div class="small text-muted mb-3">
                <strong>
                  <%= studentClassSummary.departmentLabel %>
                </strong> •
                Group <strong>
                  <%= studentClassSummary.groupName %>
                </strong> •
                <%= studentClassSummary.dayName %>
              </div>

              <div class="mb-3">
                <div class="fw-semibold text-secondary mb-1">Present Class</div>
                <% if (studentClassSummary.presentClass) { %>
                  <span class="class-chip">
                    <%= studentClassSummary.presentClass.time || '--:--' %>
                  </span>
                  <span>
                    <%= (studentClassSummary.presentClass.entries && studentClassSummary.presentClass.entries[0] &&
                      studentClassSummary.presentClass.entries[0].subject) || (studentClassSummary.presentClass.isFree
                      ? 'Free Period' : 'Class' ) %>
                  </span>
                  <% } else { %>
                    <span class="text-muted">No class running right now.</span>
                    <% } %>
              </div>

              <div>
                <div class="fw-semibold text-secondary mb-1">Next Class</div>
                <% if (studentClassSummary.nextClass) { %>
                  <span class="class-chip">
                    <%= studentClassSummary.nextClass.time || '--:--' %>
                  </span>
                  <span>
                    <%= (studentClassSummary.nextClass.entries && studentClassSummary.nextClass.entries[0] &&
                      studentClassSummary.nextClass.entries[0].subject) || (studentClassSummary.nextClass.isFree
                      ? 'Free Period' : 'Class' ) %>
                  </span>
                  <% } else { %>
                    <span class="text-muted">No more classes scheduled for today.</span>
                    <% } %>
              </div>
            </div>
          </div>
        </div>
      </div>
      <% } %>

        <!-- Notices -->
        <div class="row mb-5">
          <div class="col-lg-8 mx-auto">
            <h2 class="section-title text-center mb-4"><i class="fas fa-bullhorn text-accent me-2"></i>Latest Updates
            </h2>

            <% if (notices.length===0) { %>
              <div class="alert alert-info border-0 rounded-4 text-center">
                <i class="fas fa-info-circle me-2"></i> No notices available at the moment. Please check back later.
              </div>
              <% } else { %>
                <% notices.forEach(notice=> { %>
                  <div class="card notice-card">
                    <div class="card-body p-4">
                      <h5 class="card-title"><i class="fas fa-sticky-note text-primary me-2"></i>
                        <%= notice.title %>
                      </h5>
                      <div class="card-text mt-2"><%- notice.message %></div>
                      <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">
                        <span class="notice-meta">
                          <i class="fas fa-user me-1"></i> Posted by <%= notice.postedBy && notice.postedBy.name ?
                            notice.postedBy.name : 'Admin' %>
                        </span>
                        <span class="notice-meta">
                          <i class="fas fa-calendar-alt me-1"></i>
                          <%= notice.date ? new Date(notice.date).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata' })
                            : '' %>
                        </span>
                      </div>
                    </div>
                  </div>
                  <% }) %>
                    <% } %>
          </div>
        </div>
  </div>

  <!-- Timetable quick link -->
  <a href="/timetable" class="timetable-fab"><i class="fas fa-calendar-alt me-2"></i>Timetable</a>

  <!-- Team & Admin Section -->
  <section class="team-section py-5">
    <div class="container">
      <div class="text-center mb-4">
        <h3 class="section-title">Admin</h3>
        <p class="text-muted mb-0">Primary administrator — manages notices &amp; announcements</p>
      </div>

      <div class="row justify-content-center mb-5">
        <div class="col-12 col-md-6 col-lg-4">
          <div class="card profile-card text-center p-4">
            <img src="/images/KaranProfile.png" alt="Admin photo" class="profile-avatar mx-auto d-block mb-3">
            <div class="card-body p-0">
              <h5 class="mb-1 fw-bold">Karan Singh</h5>
              <div class="mb-2"><span class="team-badge">Head Admin • CSE</span></div>
              <p class="text-muted small mb-3">Responsible for posting official notices and managing user subscriptions.
              </p>
              <div>
                <a href="https://www.linkedin.com/in/karan-singh-36bb6b274/" class="social-icon"><i
                    class="fab fa-linkedin-in"></i></a>
                <a href="https://github.com/CS4410" class="social-icon"><i class="fab fa-github"></i></a>
                <a href="mailto:singhkaran91973@gmail.com" class="social-icon"><i class="fas fa-envelope"></i></a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="text-center mb-4">
        <h3 class="section-title">Our Team</h3>
        <p class="text-muted mb-4">Dedicated team that builds and maintains InfoCascade</p>
      </div>

      <div class="row g-4 justify-content-center">
        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
          <div class="card profile-card text-center p-3 h-100">
            <img src="/images/JayantProfile1.png" alt="Team member" class="profile-avatar mx-auto d-block mb-3">
            <div class="card-body p-0">
              <h6 class="mb-0 fw-bold">Jayant Kumawat</h6>
              <small class="text-muted">(B.Tech-CSE)</small><br>
              <small class="text-muted">Technical &amp; Communications Specialist</small>
            </div>
          </div>
        </div>

        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
          <div class="card profile-card text-center p-3 h-100">
            <img src="/images/KiranjitProfile.png" alt="Team member" class="profile-avatar mx-auto d-block mb-3">
            <div class="card-body p-0">
              <h6 class="mb-0 fw-bold">Kiranjeet Kour</h6>
              <small class="text-muted">(B.Tech-CSE)</small><br>
              <small class="text-muted">Technical Analyst</small>
            </div>
          </div>
        </div>

        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
          <div class="card profile-card text-center p-3 h-100">
            <img src="/images/AbhayProfile.png" alt="Team member" class="profile-avatar mx-auto d-block mb-3">
            <div class="card-body p-0">
              <h6 class="mb-0 fw-bold">Abhay Singh</h6>
              <small class="text-muted">(B.Tech-CE)</small><br>
              <small class="text-muted">Communication &amp; Outreach Coordinator</small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <button id="backToTop" aria-label="Back to top"><i class="fas fa-arrow-up"></i></button>

  <footer class="text-white pt-5 pb-4">
    <div class="container">
      <div class="row gy-4">
        <div class="col-md-4">
          <h5 class="fw-bold mb-3">InfoCascade</h5>
          <p class="small text-white-50">
            InfoCascade delivers trusted and timely college notices — academics, events, results and more.
          </p>
          <div class="d-flex gap-2 mt-3">
            <a href="https://www.linkedin.com" target="_blank" class="btn btn-outline-light btn-sm"><i
                class="fab fa-linkedin-in"></i></a>
            <a href="https://github.com" target="_blank" class="btn btn-outline-light btn-sm"><i
                class="fab fa-github"></i></a>
            <a href="mailto:infocascade.gndec@gmail.com" class="btn btn-outline-light btn-sm"><i
                class="fas fa-envelope"></i></a>
          </div>
        </div>

        <div class="col-md-4">
          <h6 class="fw-semibold">Quick Links</h6>
          <ul class="list-unstyled small">
            <li><a href="/" class="text-white text-decoration-none">Home</a></li>
            <li><a href="/timetable" class="text-white text-decoration-none">Timetable</a></li>
            <li><a href="/admin/login" class="text-white text-decoration-none">Admin Login</a></li>
            <li><a href="#" class="text-white text-decoration-none">Privacy Policy</a></li>
