        <div class="d-flex align-items-center gap-3">
          <button class="btn btn-outline-light btn-sm" data-bs-toggle="modal" data-bs-target="#feedbackModal">
            <i class="fas fa-comment-dots me-1"></i> Feedback
          </button>
          <small class="text-white mb-0">Designed &amp; Developed by Karan Singh</small>
