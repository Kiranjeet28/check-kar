<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Student Login | InfoCascade</title>
  <link rel="icon" href="/images/Infocascade.png" type="image/png" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
    rel="stylesheet">
  <style>
    :root {
      --primary-color: #4e73df;
      --primary-dark: #3a5bc7;
      --secondary-color: #2c3e50;
      --ink: #1f2a37;
      --muted: #6b7a90;
      --line: #e6eaf1;
      --radius: 18px;
      --shadow-lg: 0 24px 60px -24px rgba(24, 39, 75, 0.35);
    }

    body {
      background:
        radial-gradient(900px 500px at 12% -10%, rgba(78, 115, 223, 0.18), transparent 60%),
        radial-gradient(800px 480px at 100% 110%, rgba(44, 62, 80, 0.16), transparent 60%),
        #f5f7fb;
      font-family: 'Plus Jakarta Sans', 'Segoe UI', Tahoma, sans-serif;
      color: var(--ink);
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
    }

    .home-btn {
      position: absolute;
      top: 24px;
      left: 24px;
      z-index: 1000;
      border-radius: 999px;
      padding: 0.5rem 1.1rem;
      font-weight: 600;
      border: 1px solid var(--line);
      background: rgba(255, 255, 255, 0.85);
      color: var(--secondary-color);
      backdrop-filter: blur(8px);
      text-decoration: none;
      transition: all 0.25s ease;
    }

    .home-btn:hover {
      background: #fff;
      color: var(--primary-color);
      transform: translateX(-2px);
    }

    .login-card {
      border: 1px solid rgba(255, 255, 255, 0.7);
      border-radius: var(--radius);
      box-shadow: var(--shadow-lg);
      overflow: hidden;
      background: #fff;
    }

    .card-header {
      background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
      color: #fff;
      text-align: center;
      padding: 2.4rem 2rem;
      border-bottom: none;
    }

    .brand-badge {
      width: 56px;
      height: 56px;
      margin: 0 auto 1rem;
      border-radius: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(255, 255, 255, 0.16);
      font-size: 1.35rem;
    }

    .card-header h3 {
      font-weight: 800;
      letter-spacing: -0.02em;
      margin-bottom: 0.25rem;
    }

    .card-header p {
      opacity: 0.82;
      font-size: 0.92rem;
      margin-bottom: 0;
    }

    .card-body {
      padding: 2.25rem 2rem 2rem;
    }

    .form-label {
      font-weight: 600;
      font-size: 0.85rem;
      color: var(--secondary-color);
      margin-bottom: 0.45rem;
    }

    .form-control {
      padding: 0.8rem 1rem;
      border-radius: 12px;
      border: 1px solid var(--line);
      background: #fbfcfe;
      font-size: 0.95rem;
      transition: all 0.2s ease;
    }

    .form-control:focus {
      background: #fff;
      border-color: var(--primary-color);
      box-shadow: 0 0 0 4px rgba(78, 115, 223, 0.15);
    }

    .input-group .form-control {
      border-radius: 12px 0 0 12px;
    }

    .input-group .btn-outline-secondary {
      border-color: var(--line);
      border-radius: 0 12px 12px 0;
      color: var(--muted);
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
      border: none;
      padding: 0.85rem;
      border-radius: 12px;
      font-weight: 700;
      box-shadow: 0 12px 24px -12px rgba(78, 115, 223, 0.75);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .btn-primary:hover:not(:disabled) {
      transform: translateY(-1px);
      box-shadow: 0 16px 30px -12px rgba(78, 115, 223, 0.85);
    }

    .register-link {
      color: var(--primary-color);
      font-weight: 600;
      text-decoration: none;
    }

    .register-link:hover {
      text-decoration: underline;
    }

    .feedback {
      min-height: 22px;
      font-size: 0.88rem;
      font-weight: 600;
      margin-top: 0.6rem;
      text-align: center;
    }

    .secure-note {
      font-size: 0.78rem;
      color: var(--muted);
      text-align: center;
      margin-top: 1.1rem;
    }

    @media (max-width: 600px) {
      .card-body {
        padding: 1.4rem;
      }
    }
  </style>
</head>

<body>
  <a href="/" class="home-btn"><i class="fas fa-arrow-left me-2"></i>Back to Home</a>

  <main class="container d-flex align-items-center justify-content-center" style="min-height: 100vh;">
    <div class="col-12 col-sm-10 col-md-7 col-lg-5">
      <div class="card login-card">
        <div class="card-header">
          <div class="brand-badge"><i class="fas fa-user-graduate"></i></div>
          <h3>Student Login</h3>
          <p>Access your InfoCascade account</p>
        </div>
        <div class="card-body">
          <form id="loginForm" autocomplete="on">
            <input type="hidden" id="csrfToken" value="<%= csrfToken %>" />
            <div class="mb-3">
              <label for="email" class="form-label">Email (Gmail)</label>
              <input type="email" class="form-control" id="email" name="email" placeholder="you@gmail.com" required
                autocomplete="username" maxlength="254" title="Use a valid Gmail address (@gmail.com)" />
            </div>
            <div class="mb-4">
              <label for="password" class="form-label">Password</label>
              <div class="input-group">
                <input type="password" class="form-control" id="password" name="password" placeholder="••••••••"
                  required autocomplete="current-password" />
                <button class="btn btn-outline-secondary" type="button" id="togglePassword" tabindex="-1"
                  aria-label="Show password"><i class="fas fa-eye"></i></button>
              </div>
            </div>
            <button type="submit" class="btn btn-primary w-100" id="loginBtn">
              <span id="loginBtnText"><i class="fas fa-sign-in-alt me-2"></i>Login</span>
              <span id="loginSpinner" class="spinner-border spinner-border-sm d-none" role="status"
                aria-hidden="true"></span>
            </button>
          </form>
          <div id="loginError" class="feedback text-danger"></div>
          <div id="loginSuccess" class="feedback text-success"></div>
          <div class="mt-2 text-center">
            <a href="/register" class="register-link">Don't have an account? Register</a>
          </div>
          <p class="secure-note"><i class="fas fa-shield-halved me-1"></i>Protected session · expires after inactivity
          </p>
        </div>
      </div>
    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    function isValidGmailAddress(email) {
      var t = email.trim();
      if (!t) return false;
      var lower = t.toLowerCase();
      if (!lower.endsWith('@gmail.com')) return false;
      if (t.indexOf(' ') !== -1) return false;
      var local = lower.slice(0, -10);
      if (!local.length) return false;
      return /^[a-zA-Z0-9._%+-]+$/.test(local);
    }

    document.addEventListener('DOMContentLoaded', function () {
      var pwd = document.getElementById('password');
      var toggle = document.getElementById('togglePassword');
      if (toggle && pwd) {
        toggle.addEventListener('click', function () {
          if (pwd.type === 'password') {
            pwd.type = 'text';
            toggle.innerHTML = '<i class="fas fa-eye-slash"></i>';
            toggle.setAttribute('aria-label', 'Hide password');
          } else {
            pwd.type = 'password';
            toggle.innerHTML = '<i class="fas fa-eye"></i>';
            toggle.setAttribute('aria-label', 'Show password');
          }
        });
      }
    });

    document.getElementById('loginForm').addEventListener('submit', async function (e) {
      e.preventDefault();
      var emailInput = document.getElementById('email').value.trim();
      var email = emailInput.toLowerCase();
      const password = document.getElementById('password').value;
      const errorDiv = document.getElementById('loginError');
      const successDiv = document.getElementById('loginSuccess');
      if (!isValidGmailAddress(emailInput)) {
        errorDiv.textContent = 'Enter a valid email address that ends with @gmail.com';
        return;
      }
      const btn = document.getElementById('loginBtn');
      const btnText = document.getElementById('loginBtnText');
      const spinner = document.getElementById('loginSpinner');
      errorDiv.textContent = '';
      successDiv.textContent = '';
      btn.disabled = true;
      btnText.textContent = 'Logging in...';
      spinner.classList.remove('d-none');
      try {
        const csrfToken = document.getElementById('csrfToken').value;
        const res = await fetch('/login', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'CSRF-Token': csrfToken
          },
          body: JSON.stringify({ email: email, password: password })
        });
        const data = await res.json();
        if (res.ok && data.success) {
          successDiv.textContent = 'Login successful! Redirecting...';
          setTimeout(() => { window.location.href = '/'; }, 800);
        } else {
          errorDiv.textContent = data.error || 'Login failed.';
        }
      } catch (err) {
        errorDiv.textContent = 'Network error.';
      }
      btn.disabled = false;
      btnText.innerHTML = '<i class="fas fa-sign-in-alt me-2"></i>Login';
      spinner.classList.add('d-none');
    });
  </script>
</body>

</html>