<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Student Registration | InfoCascade</title>
  <link rel="icon" href="/images/Infocascade.png" type="image/png" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
    rel="stylesheet">
  <style>
    :root {
      --primary-color: #4e73df;
      --primary-dark: #3a5bc7;
      --secondary-color: #2c3e50;
      --ink: #1f2a37;
      --muted: #6b7a90;
      --line: #e6eaf1;
      --radius: 18px;
      --shadow-lg: 0 24px 60px -24px rgba(24, 39, 75, 0.35);
    }

    body {
      background:
        radial-gradient(900px 500px at 12% -10%, rgba(78, 115, 223, 0.18), transparent 60%),
        radial-gradient(800px 480px at 100% 110%, rgba(44, 62, 80, 0.16), transparent 60%),
        #f5f7fb;
      font-family: 'Plus Jakarta Sans', 'Segoe UI', Tahoma, sans-serif;
      color: var(--ink);
      -webkit-font-smoothing: antialiased;
    }

    .register-card {
      border: 1px solid rgba(255, 255, 255, 0.7);
      border-radius: var(--radius);
      box-shadow: var(--shadow-lg);
      overflow: hidden;
      background: #fff;
    }

    .card-header {
      background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
      color: #fff;
      text-align: center;
      padding: 2.2rem 1.5rem;
      border-bottom: none;
    }

    .brand-badge {
      width: 56px;
      height: 56px;
      margin: 0 auto 1rem;
      border-radius: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(255, 255, 255, 0.16);
      font-size: 1.35rem;
    }

    .card-header h3 {
      font-weight: 800;
      letter-spacing: -0.02em;
      margin-bottom: 0.25rem;
    }

    .card-header p {
      opacity: 0.82;
      font-size: 0.92rem;
      margin-bottom: 0;
    }

    .card-body {
      padding: 2rem;
    }

    .form-label {
      font-weight: 600;
      font-size: 0.85rem;
      color: var(--secondary-color);
      margin-bottom: 0.4rem;
    }

    .form-control,
    .form-select {
      padding: 0.75rem 1rem;
      border-radius: 12px;
      border: 1px solid var(--line);
      background: #fbfcfe;
      font-size: 0.95rem;
      transition: all 0.2s ease;
    }

    .form-control:focus,
    .form-select:focus {
      background: #fff;
      border-color: var(--primary-color);
      box-shadow: 0 0 0 4px rgba(78, 115, 223, 0.15);
    }

    .btn-submit {
      background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
      color: #fff;
      border: none;
      padding: 0.85rem;
      border-radius: 12px;
      font-weight: 700;
      box-shadow: 0 12px 24px -12px rgba(78, 115, 223, 0.75);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .btn-submit:hover:not(:disabled) {
      color: #fff;
      transform: translateY(-1px);
      box-shadow: 0 16px 30px -12px rgba(78, 115, 223, 0.85);
    }

    .btn-outline-secondary {
      border-color: var(--line);
      border-radius: 0 12px 12px 0;
      color: var(--muted);
    }

    .login-link {
      color: var(--primary-color);
      font-weight: 600;
      text-decoration: none;
    }

    .login-link:hover {
      text-decoration: underline;
    }

    .hint {
      font-size: 0.75rem;
      color: var(--muted);
    }

    @media (max-width: 576px) {
      .card-body {
        padding: 1.35rem;
      }
    }
  </style>
</head>

<body>
  <div class="container py-5">
    <div class="row justify-content-center">
      <div class="col-lg-8 col-xl-7">
        <div class="card register-card">
          <div class="card-header">
            <div class="brand-badge"><i class="fas fa-user-plus"></i></div>
            <h3>Student Registration</h3>
            <p>Create your InfoCascade account to get personalised updates</p>
          </div>
          <div class="card-body">
            <form action="/register" method="POST" id="registerForm">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <div class="row g-3">
                <div class="col-md-6">
                  <label for="name" class="form-label">Name</label>
                  <input type="text" class="form-control" id="name" name="name" required />
                </div>
                <div class="col-md-6">
                  <label for="email" class="form-label">Email</label>
                  <input type="email" class="form-control" id="email" name="email" required autocomplete="email"
                    maxlength="254" title="Use a valid Gmail address (@gmail.com)" />
                  <div class="hint mt-1">Must end with @gmail.com</div>
                </div>
                <div class="col-md-6">
                  <label for="password" class="form-label">Password</label>
                  <div class="input-group">
                    <input type="password" class="form-control" id="password" name="password" minlength="6" required
                      autocomplete="new-password" />
                    <button class="btn btn-outline-secondary" type="button" id="togglePassword" tabindex="-1"
                      aria-label="Show password"><i class="fas fa-eye"></i></button>
                  </div>
                </div>
                <div class="col-md-6">
                  <label for="urn" class="form-label">URN (7 digits)</label>
                  <input type="text" class="form-control" id="urn" name="urn" inputmode="numeric" pattern="\d{7}"
                    maxlength="7" minlength="7" required title="URN must be exactly 7 digits (numbers only)" />
                </div>
                <div class="col-md-6">
                  <label for="crn" class="form-label">CRN (7 digits)</label>
                  <input type="text" class="form-control" id="crn" name="crn" inputmode="numeric" pattern="\d{7}"
                    maxlength="7" minlength="7" required title="CRN must be exactly 7 digits (numbers only)" />
                </div>
                <div class="col-md-6">
                  <label for="department" class="form-label">Department</label>
                  <select class="form-select" id="department" name="department" required>
                    <option value="">Select department</option>
                  </select>
                </div>
                <div class="col-12">
                  <label for="group" class="form-label">Group</label>
                  <select class="form-select" id="group" name="group" required disabled>
                    <option value="">Select department first</option>
                  </select>
                </div>
              </div>
              <button type="submit" class="btn btn-submit w-100 mt-4">
                <i class="fas fa-circle-check me-2"></i>Create Account
              </button>
            </form>
            <div id="registerError" class="text-danger text-center mt-3 fw-semibold small"></div>
            <div id="registerSuccess" class="text-success text-center mt-3 fw-semibold small"></div>
            <div class="mt-3 text-center">
              <a href="/login" class="login-link">Already have an account? Login</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Live data source (GitHub raw) -- file names verified against the repository.
    const DATA_BASE = 'https://raw.githubusercontent.com/Kiranjeet28/infocascade-data/main/web';
    const DEPARTMENTS = [
      { key: 'cse', label: 'CSE', groupFile: 'group/cse.json' },
      { key: 'it', label: 'IT', groupFile: 'group/it.json' },
      { key: 'ece', label: 'ECE', groupFile: 'group/ece.json' },
      { key: 'electrical', label: 'Electrical', groupFile: 'group/electrical.json' },
      { key: 'mechanical', label: 'Mechanical', groupFile: 'group/mechanical.json' },
      { key: 'civil', label: 'Civil', groupFile: 'group/civil.json' },
      { key: 'appliedscience', label: 'Applied Science', groupFile: 'group/appliedscience.json' },
      { key: 'bca', label: 'BCA', groupFile: 'group/bca.json' }
    ];

    function isValidGmailAddress(email) {
      var t = email.trim();
      if (!t) return false;
      var lower = t.toLowerCase();
      if (!lower.endsWith('@gmail.com')) return false;
      if (t.indexOf(' ') !== -1) return false;
      var local = lower.slice(0, -('@gmail.com'.length));
      if (!local.length) return false;
      return /^[a-zA-Z0-9._%+-]+$/.test(local);
    }

    function digitsOnly(el, maxLen) {
      el.addEventListener('input', function () {
        var v = el.value.replace(/\D/g, '').slice(0, maxLen);
        if (el.value !== v) el.value = v;
      });
    }

    const departmentSelect = document.getElementById('department');
    const groupSelect = document.getElementById('group');

    document.addEventListener('DOMContentLoaded', function () {
      var urnEl = document.getElementById('urn');
      var crnEl = document.getElementById('crn');
      if (urnEl) digitsOnly(urnEl, 7);
      if (crnEl) digitsOnly(crnEl, 7);

      var pwd = document.getElementById('password');
      var toggle = document.getElementById('togglePassword');
      if (toggle && pwd) {
        toggle.addEventListener('click', function () {
          if (pwd.type === 'password') {
            pwd.type = 'text';
            toggle.innerHTML = '<i class="fas fa-eye-slash"></i>';
            toggle.setAttribute('aria-label', 'Hide password');
          } else {
            pwd.type = 'password';
            toggle.innerHTML = '<i class="fas fa-eye"></i>';
            toggle.setAttribute('aria-label', 'Show password');
          }
        });
      }

      departmentSelect.innerHTML = '<option value="">Select department</option>' +
        DEPARTMENTS.map((d) => `<option value="${d.key}">${d.label}</option>`).join('');
    });

    async function loadGroups(departmentKey) {
      const department = DEPARTMENTS.find((d) => d.key === departmentKey);
      groupSelect.innerHTML = '<option value="">Loading groups...</option>';
      groupSelect.disabled = true;
      if (!department) return;
      try {
        const res = await fetch(`${DATA_BASE}/${department.groupFile}`, { cache: 'no-cache' });
        if (!res.ok) throw new Error('failed');
        const data = await res.json();
        const groups = Array.isArray(data) ? data : (data.groups || []);
        if (!groups.length) {
          groupSelect.innerHTML = '<option value="">No groups found</option>';
          return;
        }
        groupSelect.innerHTML = '<option value="">Select group</option>' +
          groups.map((group) => `<option value="${group}">${group}</option>`).join('');
        groupSelect.disabled = false;
      } catch (error) {
        groupSelect.innerHTML = '<option value="">Unable to load groups</option>';
      }
    }

    departmentSelect.addEventListener('change', function () {
      const departmentKey = this.value;
      if (!departmentKey) {
        groupSelect.innerHTML = '<option value="">Select department first</option>';
        groupSelect.disabled = true;
        return;
      }
      loadGroups(departmentKey);
    });

    document.getElementById('registerForm').addEventListener('submit', async function (e) {
      e.preventDefault();
      const errorEl = document.getElementById('registerError');
      const successEl = document.getElementById('registerSuccess');
      errorEl.textContent = '';
      successEl.textContent = '';

      const formData = new FormData(this);
      const payload = Object.fromEntries(formData.entries());
      const urn = String(payload.urn || '').trim();
      const crn = String(payload.crn || '').trim();
      const emailRaw = String(payload.email || '').trim();

      if (!/^\d{7}$/.test(urn)) {
        errorEl.textContent = 'URN must be exactly 7 digits.';
        return;
      }
      if (!/^\d{7}$/.test(crn)) {
        errorEl.textContent = 'CRN must be exactly 7 digits.';
        return;
      }
      if (!isValidGmailAddress(emailRaw)) {
        errorEl.textContent = 'Enter a valid email address that ends with @gmail.com';
        return;
      }

      try {
        const res = await fetch('/register', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'CSRF-Token': payload._csrf
          },
          body: JSON.stringify({
            name: payload.name,
            email: emailRaw.toLowerCase(),
            password: payload.password,
            urn: urn,
            crn: crn,
            department: payload.department,
            group: payload.group
          })
        });

        const data = await res.json();
        if (!res.ok) {
          if (Array.isArray(data.errors) && data.errors.length > 0) {
            errorEl.textContent = data.errors[0].msg || 'Registration failed.';
          } else {
            errorEl.textContent = data.error || 'Registration failed.';
          }
          return;
        }

        successEl.textContent = 'Registration successful! Redirecting to login...';
        setTimeout(() => { window.location.href = '/login'; }, 900);
      } catch (error) {
        errorEl.textContent = 'Network error. Please try again.';
      }
    });
  </script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>