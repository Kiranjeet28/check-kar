<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Timetable | InfoCascade</title>
  <link rel="icon" href="/images/Infocascade.png" type="image/png" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
    rel="stylesheet">
  <style>
    :root {
      --primary-color: #4e73df;
      --primary-dark: #3a5bc7;
      --secondary-color: #2c3e50;
      --ink: #1f2a37;
      --muted: #6b7a90;
      --line: #e6eaf1;
      --radius: 18px;
      --shadow: 0 22px 55px -28px rgba(24, 39, 75, 0.32);
    }

    body {
      background:
        radial-gradient(900px 480px at 8% -10%, rgba(78, 115, 223, 0.16), transparent 60%),
        radial-gradient(760px 460px at 100% 8%, rgba(44, 62, 80, 0.12), transparent 60%),
        #f5f7fb;
      font-family: 'Plus Jakarta Sans', 'Segoe UI', Tahoma, sans-serif;
      color: var(--ink);
      -webkit-font-smoothing: antialiased;
    }

    .navbar {
      background: rgba(255, 255, 255, 0.85) !important;
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--line);
    }

    .navbar-brand {
      font-weight: 800;
      letter-spacing: -0.02em;
      color: var(--secondary-color) !important;
    }

    .navbar .nav-link {
      color: var(--muted) !important;
      font-weight: 600;
      font-size: 0.92rem;
    }

    .navbar .nav-link.active,
    .navbar .nav-link:hover {
      color: var(--primary-color) !important;
    }

    .page-head {
      background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
      color: #fff;
      border-radius: var(--radius);
      padding: 2.2rem 1.75rem;
      box-shadow: var(--shadow);
      margin-bottom: 1.75rem;
    }

    .page-head h1 {
      font-weight: 800;
      letter-spacing: -0.03em;
      font-size: 1.9rem;
    }

    .page-head p {
      opacity: 0.85;
      margin-bottom: 0;
    }

    .timetable-section {
      background: #fff;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 1.5rem;
      box-shadow: var(--shadow);
      margin-bottom: 2.5rem;
    }

    .department-switcher {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-bottom: 1.25rem;
    }

    .department-chip {
      border: 1px solid var(--line);
      background: #f7f9fc;
      color: var(--secondary-color);
      border-radius: 999px;
      padding: 0.5rem 1rem;
      font-weight: 600;
      font-size: 0.88rem;
      transition: all 0.2s ease;
    }

    .department-chip.active,
    .department-chip:hover {
      border-color: transparent;
      background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
      color: #fff;
      box-shadow: 0 10px 22px -12px rgba(78, 115, 223, 0.85);
    }

    .department-group-label {
      background: linear-gradient(135deg, var(--secondary-color), #1b2733);
      color: #fff;
      border-radius: 14px;
      padding: 0.85rem 1.1rem;
      font-weight: 700;
      margin-bottom: 1rem;
      position: sticky;
      top: 10px;
      z-index: 5;
    }

    .form-select {
      border-radius: 12px;
      border: 1px solid var(--line);
      background-color: #fbfcfe;
      padding: 0.7rem 1rem;
      font-weight: 500;
    }

    .form-select:focus {
      border-color: var(--primary-color);
      box-shadow: 0 0 0 4px rgba(78, 115, 223, 0.15);
    }

    .day-tabs {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      margin-bottom: 1.1rem;
    }

    .day-tab {
      border: 1px solid var(--line);
      background: #fff;
      color: var(--secondary-color);
      border-radius: 10px;
      padding: 0.45rem 0.95rem;
      font-weight: 600;
      font-size: 0.88rem;
      transition: all 0.2s ease;
    }

    .day-tab:hover {
      border-color: var(--primary-color);
      color: var(--primary-color);
    }

    .day-tab.active {
      background: var(--secondary-color);
      color: #fff;
      border-color: var(--secondary-color);
    }

    .period-card {
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 1rem 1.1rem;
      margin-bottom: 0.75rem;
      background: #fff;
      transition: box-shadow 0.2s ease, transform 0.2s ease;
    }

    .period-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 16px 32px -22px rgba(24, 39, 75, 0.5);
    }

    .period-time {
      font-weight: 800;
      color: var(--primary-dark);
      min-width: 72px;
      font-variant-numeric: tabular-nums;
    }

    .type-badge {
      border-radius: 999px;
      padding: 0.2rem 0.6rem;
      font-size: 0.7rem;
      font-weight: 800;
      letter-spacing: 0.04em;
      margin-right: 0.3rem;
      display: inline-block;
    }

    .type-lab {
      background: #e8f7ff;
      color: #0f6e9a;
    }

    .type-tut {
      background: #fff5dd;
      color: #875800;
    }

    .type-elective {
      background: #efe8ff;
      color: #4f2f8f;
    }

    .type-free {
      background: #eef2f7;
      color: #5c6775;
    }

    .period-entry {
      border-left: 3px solid #dbe4ef;
      padding-left: 0.7rem;
      margin-top: 0.5rem;
    }

    .period-entry.elective {
      border-left-color: #8d6be3;
      background: #faf7ff;
      padding: 0.55rem 0.7rem;
      border-radius: 10px;
    }

    .source-note {
      font-size: 0.78rem;
      color: var(--muted);
      margin-top: 1rem;
    }

    @media (max-width: 768px) {
      .timetable-section {
        padding: 1rem;
      }

      .period-time {
        min-width: auto;
      }

      .page-head {
        padding: 1.6rem 1.15rem;
      }
    }
  </style>
</head>

<body>
  <nav class="navbar navbar-expand-lg sticky-top">
    <div class="container">
      <a class="navbar-brand" href="/"><i class="fas fa-tower-broadcast me-2 text-primary"></i>InfoCascade</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
        aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="mainNavbar">
        <div class="navbar-nav ms-auto text-center">
          <a class="nav-link" href="/">Home</a>
          <a class="nav-link active" href="/timetable">Timetable</a>
          <% if (currentUser) { %>
            <a class="nav-link" href="/profile">Profile</a>
            <% } else { %>
              <a class="nav-link" href="/login">Login</a>
              <% } %>
        </div>
      </div>
    </div>
  </nav>

  <main class="container py-4">
    <div class="page-head">
      <h1><i class="fas fa-calendar-alt me-2"></i>Department Timetables</h1>
      <p>Pick a department and group, then switch days to view every period in order.</p>
    </div>

    <section class="timetable-section" id="timetableSection">
      <% if (currentUser && currentUser.department && currentUser.group) { %>
        <div class="alert alert-info border-0 rounded-4 mb-3">
          Showing your timetable for <strong>
            <%= currentUser.department %>
          </strong> • <strong>
            <%= currentUser.group %>
          </strong>.
        </div>
        <% } %>

          <div class="department-switcher" id="departmentSwitcher"></div>
          <div class="mb-3">
            <label class="form-label fw-semibold" for="groupSelector">Select Group</label>
            <select id="groupSelector" class="form-select" disabled>
              <option value="">Select department first</option>
            </select>
          </div>
          <div class="department-group-label" id="departmentGroupLabel">Department</div>
          <div class="day-tabs" id="dayTabs"></div>
          <div id="dayPeriodList"></div>
          <p class="source-note">
            <i class="fas fa-cloud-arrow-down me-1"></i>
            Timetable and group data are loaded live from the shared InfoCascade data repository.
          </p>
    </section>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      // Live data source (GitHub raw) -- file names must match the repository exactly.
      const DATA_BASE = 'https://raw.githubusercontent.com/Kiranjeet28/infocascade-data/main/web';

      // Verified files in /web:            timetable_appliedscience.json, timetable_bca.json,
      // timetable_civil.json, timetable_cse.json, timetable_ece.json, timetable_electrical.json,
      // timetable_mechanical.json
      // Verified files in /web/group:      appliedscience.json, bca.json, civil.json, cse.json,
      // ece.json, electrical.json, it.json, mechanical.json
      const DEPARTMENTS = [
        { key: 'cse', label: 'CSE', timetableFile: 'timetable_cse.json', groupFile: 'group/cse.json' },
        { key: 'it', label: 'IT', timetableFile: null, groupFile: 'group/it.json' },
        { key: 'ece', label: 'ECE', timetableFile: 'timetable_ece.json', groupFile: 'group/ece.json' },
        { key: 'electrical', label: 'Electrical', timetableFile: 'timetable_electrical.json', groupFile: 'group/electrical.json' },
        { key: 'mechanical', label: 'Mechanical', timetableFile: 'timetable_mechanical.json', groupFile: 'group/mechanical.json' },
        { key: 'civil', label: 'Civil', timetableFile: 'timetable_civil.json', groupFile: 'group/civil.json' },
        { key: 'appliedscience', label: 'Applied Science', timetableFile: 'timetable_appliedscience.json', groupFile: 'group/appliedscience.json' },
        { key: 'bca', label: 'BCA', timetableFile: 'timetable_bca.json', groupFile: 'group/bca.json' }
      ];

      const currentUser =  JSON.stringify(currentUser || null) ;
      const userLockedTimetable = Boolean(currentUser && currentUser.department && currentUser.group);
      const dayOrder = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];

      const departmentSwitcher = document.getElementById('departmentSwitcher');
      const groupSelector = document.getElementById('groupSelector');
      const departmentGroupLabel = document.getElementById('departmentGroupLabel');
      const dayTabs = document.getElementById('dayTabs');
      const dayPeriodList = document.getElementById('dayPeriodList');

      const remoteCache = {};

      let activeDepartmentKey = null;
      let activeGroupName = '';
      let activeDepartmentData = null;
      let activeDay = 'Monday';

      function normalizeKey(value) {
        return String(value || '').toLowerCase().replace(/[^a-z]/g, '');
      }

      function findDepartment(key) {
        const wanted = normalizeKey(key);
        return DEPARTMENTS.find((department) => normalizeKey(department.key) === wanted) || null;
      }

      async function fetchJson(fileName) {
        if (remoteCache[fileName]) return remoteCache[fileName];
        const response = await fetch(`${DATA_BASE}/${fileName}`, { cache: 'no-cache' });
        if (!response.ok) throw new Error(`Failed to load ${fileName}`);
        const payload = await response.json();
        remoteCache[fileName] = payload;
        return payload;
      }

      function buildDaysFromClasses(classes) {
        const days = {};
        (Array.isArray(classes) ? classes : []).forEach((item) => {
          const day = item.dayOfClass;
          const data = item.data || {};
          if (!day) return;
          const entries = Array.isArray(data.entries) && data.entries.length
            ? data.entries
            : (data.subject ? [{ subject: data.subject, teacher: data.teacher, classRoom: data.classRoom }] : []);

          if (!days[day]) days[day] = [];
          days[day].push({
            time: item.timeOfClass || '--:--',
            isFree: Boolean(data.freeClass),
            isLab: Boolean(data.Lab),
            isTutorial: Boolean(data.Tut),
            isElective: Boolean(data.elective),
            entries: entries
          });
        });

        Object.keys(days).forEach((day) => {
          days[day].sort((a, b) => String(a.time).localeCompare(String(b.time)));
        });
        return days;
      }

      function displayTypeBadges(period) {
        const badges = [];
        if (period.isFree) badges.push('<span class="type-badge type-free">FREE</span>');
        if (period.isLab) badges.push('<span class="type-badge type-lab">LAB</span>');
        if (period.isTutorial) badges.push('<span class="type-badge type-tut">TUT</span>');
        if (period.isElective) badges.push('<span class="type-badge type-elective">ELECTIVE</span>');
        return badges.join('');
      }

      function renderPeriods() {
        if (!activeDepartmentData) {
          dayPeriodList.innerHTML = '<div class="alert alert-warning border-0 rounded-4">No timetable data available.</div>';
          return;
        }

        departmentGroupLabel.textContent = `${activeDepartmentData.department.label} • ${activeDepartmentData.groupName || 'Group Not Available'}`;
        const periods = activeDepartmentData.days && activeDepartmentData.days[activeDay] ? activeDepartmentData.days[activeDay] : [];

        if (!periods.length) {
          dayPeriodList.innerHTML = `<div class="alert alert-light border rounded-4">No periods available for <strong>${activeDay}</strong>.</div>`;
          return;
        }

        dayPeriodList.innerHTML = periods.map((period) => {
          const entries = Array.isArray(period.entries) ? period.entries : [];
          const entryMarkup = (entries.length ? entries : [{}]).map((entry) => {
            const subjectName = entry.subject || (period.isFree ? 'Free Period' : 'Subject Not Available');
            const teacher = entry.teacher ? `<div class="small text-muted"><i class="fas fa-user me-1"></i>${entry.teacher}</div>` : '';
            const room = entry.classRoom ? `<div class="small text-muted"><i class="fas fa-location-dot me-1"></i>${entry.classRoom}</div>` : '';
            const electiveClass = period.isElective ? 'elective' : '';

            return `
              <div class="period-entry ${electiveClass}">
                <div class="fw-semibold">${subjectName}</div>
                ${teacher}
                ${room}
              </div>
            `;
          }).join('');

          return `
            <article class="period-card">
              <div class="d-flex flex-column flex-md-row gap-2">
                <div class="period-time">${period.time || '--:--'}</div>
                <div class="flex-grow-1">
                  <div>${displayTypeBadges(period)}</div>
                  ${entryMarkup}
                </div>
              </div>
            </article>
          `;
        }).join('');
      }

      function renderDayTabs() {
        const availableDays = dayOrder.filter((day) => activeDepartmentData && activeDepartmentData.days && Array.isArray(activeDepartmentData.days[day]) && activeDepartmentData.days[day].length > 0);
        if (!availableDays.includes(activeDay)) activeDay = availableDays[0] || 'Monday';

        dayTabs.innerHTML = availableDays.map((day) => `
          <button type="button" class="day-tab ${day === activeDay ? 'active' : ''}" data-day="${day}">
            ${day}
          </button>
        `).join('');

        dayTabs.querySelectorAll('.day-tab').forEach((button) => {
          button.addEventListener('click', function () {
            activeDay = this.dataset.day;
            renderDayTabs();
            renderPeriods();
          });
        });
      }

      async function loadTimetableForSelection() {
        const department = findDepartment(activeDepartmentKey);
        if (!department || !activeGroupName) return;

        if (!department.timetableFile) {
          activeDepartmentData = null;
          dayTabs.innerHTML = '';
          departmentGroupLabel.textContent = `${department.label} • ${activeGroupName}`;
          dayPeriodList.innerHTML = '<div class="alert alert-light border rounded-4">Timetable data for this department is not published yet.</div>';
          return;
        }

        dayPeriodList.innerHTML = '<div class="text-center py-4 text-muted"><span class="spinner-border spinner-border-sm me-2"></span>Loading timetable...</div>';
        try {
          const payload = await fetchJson(department.timetableFile);
          const timetable = (payload && payload.timetable) || {};
          const groupKey = Object.keys(timetable).find((name) => name === activeGroupName)
            || Object.keys(timetable).find((name) => normalizeKey(name) === normalizeKey(activeGroupName));

          if (!groupKey) {
            activeDepartmentData = null;
            dayTabs.innerHTML = '';
            departmentGroupLabel.textContent = `${department.label} • ${activeGroupName}`;
            dayPeriodList.innerHTML = '<div class="alert alert-light border rounded-4">No timetable found for this group.</div>';
            return;
          }

          activeDepartmentData = {
            department: department,
            groupName: groupKey,
            days: buildDaysFromClasses(timetable[groupKey].classes)
          };
          renderDayTabs();
          renderPeriods();
        } catch (error) {
          activeDepartmentData = null;
          dayTabs.innerHTML = '';
          dayPeriodList.innerHTML = '<div class="alert alert-warning border-0 rounded-4">Unable to load timetable for the selected group.</div>';
        }
      }

      async function loadGroupsForDepartment() {
        const department = findDepartment(activeDepartmentKey);
        if (!department) return;

        groupSelector.disabled = true;
        groupSelector.innerHTML = '<option value="">Loading groups...</option>';
        try {
          const payload = await fetchJson(department.groupFile);
          const groups = Array.isArray(payload) ? payload : (Array.isArray(payload.groups) ? payload.groups : []);

          if (!groups.length) {
            groupSelector.innerHTML = '<option value="">No groups available</option>';
            dayTabs.innerHTML = '';
            dayPeriodList.innerHTML = '<div class="alert alert-light border rounded-4">No groups found for this department.</div>';
            return;
          }

          groupSelector.innerHTML = groups.map((group) => `<option value="${group}">${group}</option>`).join('');
          groupSelector.disabled = userLockedTimetable;
          const preferredGroup = currentUser && currentUser.group && groups.includes(currentUser.group)
            ? currentUser.group
            : groups[0];
          activeGroupName = preferredGroup;
          groupSelector.value = activeGroupName;
          await loadTimetableForSelection();
        } catch (error) {
          groupSelector.innerHTML = '<option value="">Unable to load groups</option>';
          dayTabs.innerHTML = '';
          dayPeriodList.innerHTML = '<div class="alert alert-warning border-0 rounded-4">Unable to load groups right now.</div>';
        }
      }

      function renderDepartmentSwitcher() {
        if (userLockedTimetable) {
          departmentSwitcher.innerHTML = '';
          return;
        }
        departmentSwitcher.innerHTML = DEPARTMENTS.map((department) => `
          <button type="button" class="department-chip ${normalizeKey(department.key) === normalizeKey(activeDepartmentKey) ? 'active' : ''}" data-department="${department.key}">
            ${department.label}
          </button>
        `).join('');

        departmentSwitcher.querySelectorAll('.department-chip').forEach((button) => {
          button.addEventListener('click', async function () {
            activeDepartmentKey = this.dataset.department;
            activeDepartmentData = null;
            renderDepartmentSwitcher();
            await loadGroupsForDepartment();
          });
        });
      }

      groupSelector.addEventListener('change', async function () {
        if (userLockedTimetable) return;
        activeGroupName = this.value;
        await loadTimetableForSelection();
      });

      async function bootTimetableSection() {
        const userDepartment = currentUser && currentUser.department ? findDepartment(currentUser.department) : null;
        activeDepartmentKey = (userLockedTimetable && userDepartment ? userDepartment.key : DEPARTMENTS[0].key);
        renderDepartmentSwitcher();
        await loadGroupsForDepartment();
        if (userLockedTimetable) groupSelector.disabled = true;
      }

      bootTimetableSection();
    });
  </script>
</body>

</html>